{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kohaku Korean Deck v1 (v2 plan draft)",
  "description": "教材取り込み用。UTF-8入力5 MiBまで・1〜500枚。容量、HTTP(S) URL、読み不明時の要確認はアプリでも検証する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "deck",
    "cards"
  ],
  "properties": {
    "format": {
      "const": "kohaku-korean-deck"
    },
    "schema_version": {
      "const": 1
    },
    "deck": {
      "$ref": "#/$defs/deck"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "korean",
        "reading_kana",
        "meaning_ja",
        "meaning_en"
      ],
      "properties": {
        "kind": {
          "enum": [
            "word",
            "phrase",
            "sentence"
          ]
        },
        "korean": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "reading_kana": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "meaning_ja": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "meaning_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "surface_form": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "pronunciation_hangul": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "ipa": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "pronunciation_note_ja": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "note_ja": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 3000
        },
        "needs_review": {
          "type": "boolean"
        },
        "review_note_ja": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "example": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ko",
                "ja",
                "en",
                "origin"
              ],
              "properties": {
                "ko": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "ja": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "origin": {
                  "enum": [
                    "source",
                    "generated"
                  ]
                }
              }
            }
          ]
        },
        "romanization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "description": "任意のRR式補助表記。IPAとは区別する。"
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "description_ja": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    }
  }
}
